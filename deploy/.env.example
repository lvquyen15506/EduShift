# Copy to /opt/edushift/.env on the VPS. Never commit the real file.
# Use a URL-safe random password, e.g. openssl rand -hex 24, in both values below.
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql+psycopg://edushift:replace_with_random_hex@db:5432/edushift
JWT_SECRET=replace_with_another_random_hex
IMAGE_TAG=latest
CORS_ORIGINS=https://edushift.site,https://www.edushift.site

# Real outbound SMTP is required for registration and password reset OTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=EduShift <no-reply@edushift.site>
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_STARTTLS=true
SMTP_SSL=false

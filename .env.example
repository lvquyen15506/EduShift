# Copy this file to .env for local development. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/edushift
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:3000

# Gemini chat: use one or more keys. Separate keys with commas, semicolons, or new lines.
# GEMINI_API_KEYS=AIzaSyFirstKey,AIzaSySecondKey
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash

PAYMENTS_MODE=disabled
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@edushift.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
